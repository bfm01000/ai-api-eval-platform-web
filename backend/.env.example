# Application settings only. Provider API keys are resolved from the variable
# named by each provider's credential_ref; they are never stored in TOML.
API_OBSERVATORY_PROVIDER_CONFIG_PATH=config/providers.toml
API_OBSERVATORY_LOG_LEVEL=INFO
# true: public site tests only user-supplied credentials
# false: local-only mode may use configured server credentials
API_OBSERVATORY_PUBLIC_MODE=true
API_OBSERVATORY_PUBLIC_REQUESTS_PER_MINUTE=5
API_OBSERVATORY_PUBLIC_REQUESTS_PER_DAY=30
API_OBSERVATORY_PUBLIC_GLOBAL_REQUESTS_PER_DAY=1000
API_OBSERVATORY_PUBLIC_MAX_CONCURRENCY=4
API_OBSERVATORY_PUBLIC_RUN_TIMEOUT_SECONDS=75

# Provider credentials referenced by config/providers.toml.
YLAI_TEST_API_KEY=
AICOMING_TEST_API_KEY=
