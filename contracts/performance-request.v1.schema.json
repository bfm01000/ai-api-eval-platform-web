{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-observatory.local/contracts/performance-request.v1.schema.json",
  "title": "Performance sample request v1",
  "description": "A single reproducible request to one OpenAI-compatible provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "run_id",
    "sample_index",
    "provider",
    "model",
    "mode",
    "timeout_ms",
    "input",
    "parameters",
    "created_at"
  ],
  "properties": {
    "contract_version": { "const": "performance-request.v1" },
    "request_id": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,64}$" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{8,64}$" },
    "sample_index": { "type": "integer", "minimum": 1 },
    "provider": { "$ref": "#/$defs/provider" },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "mode": { "enum": ["standard", "streaming"] },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
    "input": { "$ref": "#/$defs/input" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "endpoint", "protocol", "credential_ref", "adapter"],
      "properties": {
        "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
        "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "protocol": { "const": "openai-chat-completions" },
        "credential_ref": { "type": "string", "pattern": "^(env|keychain|vault|config):[A-Za-z0-9_.:/-]{1,120}$" },
        "adapter": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "developer", "user", "assistant"] },
        "content": { "type": "string", "maxLength": 1000000 }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "seed": { "type": "integer" },
        "stop": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test_case_id": { "type": ["string", "null"], "maxLength": 200 },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
