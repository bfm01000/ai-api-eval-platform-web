{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-observatory.local/contracts/performance-result.v1.schema.json",
  "title": "Performance sample raw result v1",
  "description": "The immutable raw result of one performance request attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "result_id",
    "status",
    "request_snapshot",
    "execution",
    "timing",
    "raw_response",
    "usage",
    "error"
  ],
  "properties": {
    "contract_version": { "const": "performance-result.v1" },
    "result_id": { "type": "string", "pattern": "^res_[A-Za-z0-9_-]{8,64}$" },
    "status": { "enum": ["succeeded", "failed", "cancelled"] },
    "request_snapshot": { "$ref": "performance-request.v1.schema.json" },
    "execution": { "$ref": "#/$defs/execution" },
    "timing": { "$ref": "#/$defs/timing" },
    "raw_response": { "$ref": "#/$defs/rawResponse" },
    "usage": { "$ref": "#/$defs/usage" },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/error" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": {
        "properties": {
          "error": { "type": "null" },
          "raw_response": {
            "properties": {
              "http_status": { "type": "integer", "minimum": 200, "maximum": 299 }
            }
          }
        }
      },
      "else": { "properties": { "error": { "$ref": "#/$defs/error" } } }
    },
    {
      "if": {
        "properties": {
          "request_snapshot": { "properties": { "mode": { "const": "standard" } } }
        }
      },
      "then": {
        "properties": {
          "timing": { "properties": { "first_content_ms": { "type": "null" } } }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "status": { "const": "succeeded" } } },
          {
            "properties": {
              "request_snapshot": { "properties": { "mode": { "const": "streaming" } } }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "timing": { "properties": { "first_content_ms": { "type": "number", "minimum": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "cancelled" } } },
      "then": {
        "properties": {
          "error": { "properties": { "category": { "const": "cancelled" } } }
        }
      }
    }
  ],
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "worker_id", "worker_version", "adapter_version", "started_at", "completed_at"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "worker_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "worker_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_clock",
        "dns_completed_ms",
        "connect_completed_ms",
        "tls_completed_ms",
        "response_headers_ms",
        "first_byte_ms",
        "first_content_ms",
        "response_completed_ms"
      ],
      "properties": {
        "duration_clock": { "const": "monotonic" },
        "dns_completed_ms": { "$ref": "#/$defs/nullableDuration" },
        "connect_completed_ms": { "$ref": "#/$defs/nullableDuration" },
        "tls_completed_ms": { "$ref": "#/$defs/nullableDuration" },
        "response_headers_ms": { "$ref": "#/$defs/nullableDuration" },
        "first_byte_ms": { "$ref": "#/$defs/nullableDuration" },
        "first_content_ms": { "$ref": "#/$defs/nullableDuration" },
        "response_completed_ms": { "type": "number", "minimum": 0 }
      }
    },
    "nullableDuration": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "rawResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_status",
        "provider_request_id",
        "headers",
        "media_type",
        "body_text",
        "body_sha256",
        "bytes_received",
        "credential_redacted",
        "truncated"
      ],
      "properties": {
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "provider_request_id": { "type": ["string", "null"], "maxLength": 500 },
        "headers": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$" },
          "additionalProperties": { "type": "string", "maxLength": 10000 }
        },
        "media_type": { "type": ["string", "null"], "maxLength": 200 },
        "body_text": { "type": ["string", "null"] },
        "body_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "bytes_received": { "type": "integer", "minimum": 0 },
        "credential_redacted": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "source": { "enum": ["provider", "reconciled", "unavailable"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "phase", "message", "retryable", "http_status", "provider_code"],
      "properties": {
        "category": {
          "enum": ["dns", "connect", "tls", "timeout", "http", "provider", "protocol", "parse", "internal", "cancelled"]
        },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)*$", "maxLength": 160 },
        "phase": {
          "enum": ["dns", "connect", "tls", "request_send", "response_headers", "response_body", "protocol_decode", "internal", "unknown"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "provider_code": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
